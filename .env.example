# Copy to .env and fill in PAPER keys from https://app.alpaca.markets (switcher: "Paper Trading").
ALPACA_API_KEY=PK_REPLACE_ME
ALPACA_SECRET_KEY=REPLACE_ME
# The agent refuses to start if this is "true". Leave it false.
ALPACA_LIVE_TRADE=false
# Anything other than the literal "false" keeps the agent in dry-run (orders printed, never sent).
DRY_RUN=true
# iex works on free accounts; sip needs a market-data subscription for recent bars.
ALPACA_DATA_FEED=iex
# Optional: absolute path to alpaca.exe if it is not on PATH.
# ALPACA_CLI_PATH=C:\path\to\alpaca.exe
