{
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server==2.4.1"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "account,assets,stock-data,news"
      }
    },
    "risk-agent-explain": {
      "command": ".venv/Scripts/python",
      "args": ["-m", "risk_agent.explain_server"]
    }
  }
}
